---
import Mainlayout from "../../Layout/Mainlayout.astro";
import { posts } from "../../data/posts";

const colorMap = {
  green: 'text-green-400 border-green-900',
  amber: 'text-amber-400 border-amber-900',
  blue:  'text-blue-400 border-blue-900',
  red:   'text-red-400 border-red-900',
} as const;
---

<Mainlayout
  title="blog — sharriy.sh"
  seoTitle="Blog — sharriy DevOps Engineer"
  seoDesc="DevOps blog posts about Kubernetes, Docker, CI/CD, Terraform and more."
>

<!-- HEADER ─────────────────────────────────────────────── -->
<section class="px-6 pt-10 pb-6 max-w-5xl mx-auto">
  <div class="font-mono text-xs text-zinc-600 mb-8 flex items-center gap-2">
    <span class="text-green-600">sharriy@devops</span><span>:</span><span class="text-blue-400">~</span><span>$</span>
    <span class="text-zinc-500">ls -la ./blog/</span>
  </div>

  <h1 class="text-4xl md:text-5xl font-bold text-white mb-3" style="font-family: 'Pixelify Sans', monospace;">
    /blog<span class="text-green-400 flicker">_</span>
  </h1>
  <p class="font-mono text-sm text-zinc-600 mb-2">
    {posts.length} posts &nbsp;·&nbsp; DevOps, Cloud, Containers, and the things that keep me up at night.
  </p>
</section>

<!-- POST LIST ──────────────────────────────────────────── -->
<section class="px-6 pb-12 max-w-5xl mx-auto">

  <!-- Category filter labels (visual only) -->
  <div class="flex flex-wrap gap-2 font-mono text-xs mb-6">
    {['all', 'Kubernetes', 'Docker', 'CI/CD', 'Terraform'].map(cat => (
      <span class="border border-zinc-800 text-zinc-600 px-3 py-1 rounded-md cursor-default hover:border-zinc-600 hover:text-zinc-400 transition-colors">
        {cat}
      </span>
    ))}
  </div>

  <!-- Posts grid -->
  <div class="space-y-4">
    {posts.map((post, i) => {
      const colors = colorMap[post.categoryColor] ?? 'text-zinc-400 border-zinc-800';
      return (
        <a href={`/blog/${post.slug}`} class="blog-card border border-zinc-800 p-6 rounded-xl flex flex-col md:flex-row md:items-start gap-5">

          <!-- Index number -->
          <div class="font-mono text-2xl text-zinc-800 shrink-0 hidden md:block" style="min-width: 2rem;">
            {String(i + 1).padStart(2, '0')}
          </div>

          <!-- Content -->
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class={`font-mono text-xs uppercase tracking-widest border px-2 py-0.5 rounded-md ${colors}`}>
                {post.category}
              </span>
              <span class="font-mono text-xs text-zinc-700">{post.date}</span>
              <span class="font-mono text-xs text-zinc-700">{post.readTime}</span>
            </div>
            <h2 class="font-bold text-white mb-2 leading-snug" style="font-family: 'Pixelify Sans', monospace;">
              {post.title}
            </h2>
            <p class="font-mono text-xs text-zinc-600 leading-relaxed">{post.excerpt}</p>
          </div>

          <!-- Arrow -->
          <div class="font-mono text-zinc-700 group-hover:text-green-400 transition-colors shrink-0 self-center text-lg hidden md:block">
            →
          </div>

        </a>
      );
    })}
  </div>

  <!-- EOF marker -->
  <div class="font-mono text-xs text-zinc-800 mt-10 text-center">
    // end of file — {posts.length} entries
  </div>

</section>

</Mainlayout>
