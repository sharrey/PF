---
import Mainlayout from "../../Layout/Mainlayout.astro";
import { posts } from "../../data/posts";
import type { Post } from "../../data/posts";

export function getStaticPaths() {
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

interface Props { post: Post }
const { post } = Astro.props;

const colorMap = {
  green: 'text-green-400',
  amber: 'text-amber-400',
  blue:  'text-blue-400',
  red:   'text-red-400',
};
const catColor = colorMap[post.categoryColor] ?? 'text-zinc-400';

// Index of current post for prev/next navigation
const idx  = posts.findIndex(p => p.slug === post.slug);
const prev = idx > 0            ? posts[idx - 1] : null;
const next = idx < posts.length - 1 ? posts[idx + 1] : null;
---

<Mainlayout
  title={`${post.title} — sharriy.sh`}
  seoTitle={post.title}
  seoDesc={post.excerpt}
>

<!-- BACK + META ────────────────────────────────────────── -->
<section class="px-6 pt-10 pb-6 max-w-3xl mx-auto">
  <a href="/blog" class="font-mono text-xs text-zinc-600 hover:text-green-400 transition-colors flex items-center gap-2 mb-10">
    ← back to /blog
  </a>

  <!-- Category tag -->
  <div class={`font-mono text-xs uppercase tracking-widest mb-4 ${catColor}`}>
    {post.category}
  </div>

  <!-- Title -->
  <h1 class="text-3xl md:text-4xl font-bold text-white mb-5 leading-tight">
    {post.title}
  </h1>

  <!-- Meta row -->
  <div class="flex flex-wrap items-center gap-4 font-mono text-xs text-zinc-600 border-b border-zinc-900 pb-6 mb-8">
    <span>{post.date}</span>
    <span>·</span>
    <span>{post.readTime}</span>
    <span>·</span>
    <span>sharriy</span>
  </div>
</section>

<!-- CONTENT ────────────────────────────────────────────── -->
<article class="px-6 pb-12 max-w-3xl mx-auto">

  {post.sections.map(section => (
    <div class="mb-10">

      {section.title && (
        <h2 class="font-bold text-lg text-white mb-4 flex items-center gap-3">
          <span class="text-green-600 text-sm">##</span>
          {section.title}
        </h2>
      )}

      {section.body.map(para => (
        <p class="font-mono text-sm text-zinc-400 leading-relaxed mb-4">{para}</p>
      ))}

      {section.code && (
        <div class="mt-4 mb-2 relative">
          <!-- Code window chrome -->
          <div class="flex items-center gap-2 px-4 py-2 border border-b-0 border-zinc-800 rounded-t-lg" style="background:#111;">
            <span class="w-2.5 h-2.5 rounded-full bg-red-600 opacity-70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500 opacity-70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-500 opacity-70"></span>
            <span class="font-mono text-xs text-zinc-700 ml-3">bash</span>
          </div>
          <pre class="code-block">{section.code}</pre>
        </div>
      )}

    </div>
  ))}

  <!-- Tags -->
  <div class="border-t border-zinc-900 pt-8 mt-8 flex flex-wrap gap-2 font-mono text-xs">
    <span class="text-zinc-700 mr-1">tags:</span>
    {['devops', post.category.toLowerCase(), 'automation'].map(tag => (
      <span class="border border-zinc-800 text-zinc-600 px-2 py-0.5 rounded-md">#{tag}</span>
    ))}
  </div>

</article>

<!-- PREV / NEXT ─────────────────────────────────────────── -->
<nav class="px-6 pb-10 max-w-3xl mx-auto border-t border-zinc-900">
  <div class="pt-8 grid grid-cols-2 gap-4 font-mono text-xs">

    {prev ? (
      <a href={`/blog/${prev.slug}`}
        class="border border-zinc-800 p-4 rounded-xl hover:border-zinc-600 transition-colors text-left">
        <div class="text-zinc-700 mb-1">← prev</div>
        <div class="text-zinc-400 leading-snug">{prev.title}</div>
      </a>
    ) : <div></div>}

    {next && (
      <a href={`/blog/${next.slug}`}
        class="border border-zinc-800 p-4 rounded-xl hover:border-zinc-600 transition-colors text-right">
        <div class="text-zinc-700 mb-1">next →</div>
        <div class="text-zinc-400 leading-snug">{next.title}</div>
      </a>
    )}

  </div>
</nav>

</Mainlayout>
