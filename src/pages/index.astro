---
import Mainlayout from "../Layout/Mainlayout.astro";
import { posts } from "../data/posts";
import { projects } from "../data/projects";

const featured = posts.slice(0, 3);

const categoryColor: Record<string, string> = {
  green: 'text-green-400',
  amber: 'text-amber-400',
  blue:  'text-blue-400',
  red:   'text-red-400',
};
---

<Mainlayout
  title="sharriy.sh — DevOps Engineer"
  seoTitle="sharriy — DevOps Engineer"
  seoDesc="DevOps | Cloud | Automation | CI/CD | Kubernetes"
>

<!-- HERO ─────────────────────────────────────────────────── -->
<section class="relative min-h-screen overflow-hidden">

  <!-- Vertically centred content -->
  <div class="flex flex-col justify-center px-4 sm:px-6 py-20 max-w-5xl mx-auto min-h-screen">

    <div class="font-mono text-xs text-zinc-600 mb-5 flex items-center gap-2 flex-wrap">
      <span class="live-dot"></span>
      <span class="text-green-600">sharriy@devops</span><span>:</span><span class="text-blue-400">~</span><span>$</span>
      <span class="text-zinc-500">./run portfolio.sh</span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold mb-4 leading-none">
      <span class="text-zinc-300">hey, i'm </span><span class="text-green-400 flicker glitch">sharriy</span>
    </h1>

    <div class="font-mono text-base sm:text-lg md:text-xl text-zinc-400 mb-3 flex items-center gap-1">
      <span class="text-green-500 mr-1">▸</span>
      <span id="typed"></span><span class="cursor-blink ml-0.5"></span>
    </div>
    <div id="typed-strings" class="hidden">
      <p>DevOps Engineer</p>
      <p>Fullstack Developer</p>
      <p>automating CI/CD pipelines</p>
      <p>shipping products end-to-end</p>
      <p>containerizing things with Docker &amp; K8s</p>
      <p>breaking prod at 2AM — fixing it by 2:05</p>
      <p>your infrastructure's best friend</p>
    </div>

    <p class="font-mono text-xs sm:text-sm text-zinc-600 max-w-xl mb-8 leading-relaxed">
      Building pipelines. Containerizing everything.<br />
      Turning "works on my machine" into "works everywhere".
    </p>

    <div class="flex flex-wrap gap-3 font-mono text-sm">
      <a href="/about"
        class="border border-green-800 text-green-400 px-4 sm:px-5 py-2 rounded-lg hover:bg-green-500 hover:text-black hover:border-green-500 transition-all duration-150">
        ./about_me
      </a>
      <a href="/blog"
        class="border border-amber-800 text-amber-400 px-4 sm:px-5 py-2 rounded-lg hover:bg-amber-500 hover:text-black hover:border-amber-500 transition-all duration-150">
        ./blog
      </a>
      <a href="https://github.com/sharrey" target="_blank" rel="noopener"
        class="border border-zinc-700 text-zinc-500 px-4 sm:px-5 py-2 rounded-lg hover:border-zinc-400 hover:text-white transition-all duration-150 flex items-center gap-2">
        <img src="https://static.cdnlogo.com/logos/g/69/github-icon.svg" class="w-4 h-4 opacity-60" alt="" />
        ./github ↗
      </a>
    </div>
  </div>

  <!-- Scroll arrow -->
  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 font-mono text-xs text-zinc-700 animate-bounce-slow">
    ↓ scroll
  </div>
</section>

<!-- TERMINAL ─────────────────────────────────────────────── -->
<section class="px-4 sm:px-6 pt-6 pb-8">
  <div class="max-w-5xl mx-auto">
    <div class="font-mono text-xs text-zinc-600 mb-4 flex items-center gap-3" data-aos="fade-right">
      <span class="text-green-600">──</span>
      <span>$ kubectl get pods --all-namespaces</span>
    </div>
    <div class="glass-card overflow-hidden rounded-xl">
      <div class="flex items-center gap-2 px-4 py-2 border-b border-white/5" style="background: rgba(255,255,255,0.03);">
        <span class="w-3 h-3 rounded-full bg-red-600 opacity-80"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500 opacity-80"></span>
        <span class="w-3 h-3 rounded-full bg-green-500 opacity-80 pulse-terminal-dot"></span>
        <span class="ml-4 text-xs text-zinc-600 font-mono">sharriy@devops — bash — 120×30</span>
      </div>
      <div id="terminal" class="w-full overflow-x-auto" style="padding: 4px;"></div>
    </div>
  </div>
</section>

<!-- SKILLS ───────────────────────────────────────────────── -->
<section class="px-4 sm:px-6 pt-8 pb-6">
  <div class="max-w-5xl mx-auto">
    <div class="font-mono text-xs text-zinc-600 mb-6 flex items-center gap-3" data-aos="fade-right">
      <span class="text-green-600">──</span>
      <span>$ cat stack.yaml</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4" data-skills>

      {[
        {
          label: 'containers',
          items: [
            { name: 'Kubernetes', pct: 80 },
            { name: 'Docker',     pct: 92 },
            { name: 'Helm',       pct: 70 },
          ],
        },
        {
          label: 'ci/cd',
          items: [
            { name: 'GitHub Actions', pct: 90 },
            { name: 'Jenkins',        pct: 80 },
            { name: 'ArgoCD',         pct: 70 },
          ],
        },
        {
          label: 'cloud',
          items: [
            { name: 'AWS',   pct: 82 },
            { name: 'Azure', pct: 70 },
            { name: 'GCP',   pct: 60 },
          ],
        },
        {
          label: 'iac',
          items: [
            { name: 'Terraform', pct: 80 },
            { name: 'Ansible',   pct: 72 },
            { name: 'Pulumi',    pct: 50 },
          ],
        },
        {
          label: 'backend',
          items: [
            { name: 'Node.js',     pct: 82 },
            { name: 'TypeScript',  pct: 78 },
            { name: 'PostgreSQL',  pct: 74 },
            { name: 'Redis',       pct: 68 },
          ],
        },
      ].map(group => (
        <div class="glass-card p-5 rounded-xl" data-card>
          <div class="font-mono text-xs text-amber-500 mb-4 uppercase tracking-widest">{group.label}</div>
          <div class="space-y-3 font-mono text-xs">
            {group.items.map(s => (
              <div>
                <div class="flex justify-between text-zinc-400 mb-1">
                  <span><span class="text-green-600">▸</span> {s.name}</span>
                  <span class="skill-pct text-zinc-600" data-pct={s.pct}>0%</span>
                </div>
                <div class="h-0.5 bg-zinc-800 rounded-full">
                  <div class="skill-bar-fill pulse-glow h-full bg-green-500 rounded-full" data-pct={s.pct} style="width:0%;"></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

    </div>
  </div>
</section>

<!-- PROJECTS ─────────────────────────────────────────────── -->
<section id="projects" class="px-4 sm:px-6 pt-8 pb-6 border-t border-zinc-900">
  <div class="max-w-5xl mx-auto">
    <div class="font-mono text-xs text-zinc-600 mb-6 flex items-center justify-between flex-wrap gap-2" data-aos="fade-right">
      <div class="flex items-center gap-3">
        <span class="text-green-600">──</span>
        <span>$ git log --oneline --all --projects</span>
      </div>
      <a href="https://github.com/sharrey" target="_blank" rel="noopener"
        class="text-zinc-700 hover:text-green-400 transition-colors font-mono text-xs">
        github ↗
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {projects.map(proj => (
        <div class="glass-card p-5 rounded-xl flex flex-col gap-4" data-card>

          <!-- Header row -->
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="font-mono text-sm font-bold text-white mb-1">
                <span class="text-zinc-600">~/</span>{proj.name}
              </div>
              <p class="font-mono text-xs text-zinc-500 leading-relaxed">{proj.desc}</p>
            </div>
            {proj.url && (
              <a href={proj.url} target="_blank" rel="noopener"
                class="text-zinc-700 hover:text-green-400 transition-colors shrink-0 text-sm">↗</a>
            )}
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5">
            <span class="flex items-center gap-1.5 font-mono text-xs text-zinc-500">
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background:${proj.langColor};`}></span>
              {proj.lang}
            </span>
            {proj.tags.map(tag => (
              <span class="font-mono text-xs border border-zinc-800 text-zinc-600 px-2 py-0.5 rounded-md">{tag}</span>
            ))}
          </div>

          <!-- Fake git log -->
          <div class="border-t border-zinc-900 pt-3 space-y-1">
            {proj.log.map((entry, i) => (
              <div class={`font-mono text-xs flex gap-2 ${i === 0 ? 'text-zinc-400' : 'text-zinc-700'}`}>
                <span class="text-green-800 shrink-0">{entry.hash}</span>
                <span class="truncate">{entry.msg}</span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>
  </div>
</section>

<!-- BLOG PREVIEW ─────────────────────────────────────────── -->
<section class="px-4 sm:px-6 pt-8 pb-6">
  <div class="max-w-5xl mx-auto">
    <div class="font-mono text-xs text-zinc-600 mb-6 flex items-center justify-between flex-wrap gap-2" data-aos="fade-right">
      <div class="flex items-center gap-3">
        <span class="text-green-600">──</span>
        <span>$ ls -la ./blog/</span>
      </div>
      <a href="/blog" class="font-mono text-xs border border-zinc-800 text-zinc-500 px-3 py-1 rounded-lg hover:border-green-800 hover:text-green-400 transition-colors">cat all → ({posts.length})</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {featured.map(post => (
        <a href={`/blog/${post.slug}`} class="blog-card glass-card p-5 rounded-xl" data-card data-diff={JSON.stringify(post.diff)}>
          <div class={`font-mono text-xs mb-3 uppercase tracking-widest ${categoryColor[post.categoryColor]}`}>
            {post.category}
          </div>
          <h3 class="font-bold text-sm text-zinc-200 mb-3 leading-snug">
            {post.title}
          </h3>
          <p class="font-mono text-xs text-zinc-600 mb-5 leading-relaxed">{post.excerpt}</p>
          <div class="flex justify-between items-center font-mono text-xs text-zinc-700">
            <span>{post.date}</span>
            <span>{post.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CONTACT ──────────────────────────────────────────────── -->
<section id="contact" class="px-4 sm:px-6 py-10 border-t border-zinc-900">
  <div class="max-w-5xl mx-auto">
    <div class="font-mono text-xs text-zinc-600 mb-8 flex items-center gap-3" data-aos="fade-right">
      <span class="text-green-600">──</span>
      <span>$ cat contact.txt</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">

      <!-- Left: copy -->
      <div data-aos="fade-up" data-aos-delay="60">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4 leading-tight">
          let's work<br /><span class="text-green-400">together_</span>
        </h2>
        <p class="font-mono text-xs text-zinc-500 leading-relaxed max-w-sm mb-6">
          Open to DevOps, fullstack, and backend roles — freelance or full-time.<br /><br />
          Whether your pipeline is broken, your pods are crashlooping, or you need someone to build and ship a product end-to-end — I'm your person.
        </p>
        <!-- Status badge -->
        <div class="inline-flex items-center gap-2 font-mono text-xs border border-green-900 text-green-400 px-3 py-1.5 rounded-lg glass-card">
          <span class="live-dot"></span>
          available for work
        </div>
      </div>

      <!-- Right: contact cards -->
      <div class="flex flex-col gap-3" data-aos="fade-up" data-aos-delay="130">

        <a href="mailto:shar.ajaz2010@gmail.com"
          class="glass-card p-4 rounded-xl flex items-center gap-4 group">
          <div class="w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center shrink-0 group-hover:border-green-800 transition-colors">
            <span class="text-base">✉</span>
          </div>
          <div class="min-w-0">
            <div class="font-mono text-xs text-zinc-600 mb-0.5">email</div>
            <div class="font-mono text-xs text-zinc-300 truncate group-hover:text-green-400 transition-colors">shar.ajaz2010@gmail.com</div>
          </div>
          <span class="ml-auto font-mono text-zinc-700 group-hover:text-green-400 transition-colors">↗</span>
        </a>

        <a href="https://www.linkedin.com/in/sharif-ajaz-0965aa319/" target="_blank" rel="noopener"
          class="glass-card p-4 rounded-xl flex items-center gap-4 group">
          <div class="w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center shrink-0 group-hover:border-blue-800 transition-colors">
            <span class="text-base">in</span>
          </div>
          <div class="min-w-0">
            <div class="font-mono text-xs text-zinc-600 mb-0.5">linkedin</div>
            <div class="font-mono text-xs text-zinc-300 truncate group-hover:text-blue-400 transition-colors">sharif-ajaz</div>
          </div>
          <span class="ml-auto font-mono text-zinc-700 group-hover:text-blue-400 transition-colors">↗</span>
        </a>

        <a href="https://github.com/sharrey" target="_blank" rel="noopener"
          class="glass-card p-4 rounded-xl flex items-center gap-4 group">
          <div class="w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center shrink-0 group-hover:border-zinc-600 transition-colors">
            <img src="https://static.cdnlogo.com/logos/g/69/github-icon.svg" class="w-4 h-4 opacity-50 group-hover:opacity-80 transition-opacity" alt="" />
          </div>
          <div class="min-w-0">
            <div class="font-mono text-xs text-zinc-600 mb-0.5">github</div>
            <div class="font-mono text-xs text-zinc-300 truncate group-hover:text-white transition-colors">github.com/sharrey</div>
          </div>
          <span class="ml-auto font-mono text-zinc-700 group-hover:text-white transition-colors">↗</span>
        </a>

      </div>
    </div>
  </div>
</section>

<!-- CTA ──────────────────────────────────────────────────── -->
<section class="px-4 sm:px-6 py-10 flex flex-col items-center text-center">
  <div class="font-mono text-xs text-zinc-700 mb-6">$ echo "ready to ship?"</div>
  <button
    id="confetti-button"
    data-aos="fade-up"
    class="px-6 sm:px-10 py-4 sm:py-5 text-3xl sm:text-4xl md:text-6xl font-bold bg-green-500 text-black rounded-2xl hover:bg-green-400 active:scale-95 transition-all duration-150 shadow-lg shadow-green-900/30"
  >
    LET'S SHIP IT 🚀
  </button>
  <p class="font-mono text-xs text-zinc-700 mt-4">warning: may cause uncontrolled deployments</p>
</section>

<!-- CHAT TRIGGER ────────────────────────────────────────── -->
<button id="chat-trigger" aria-label="Open chat with sharriy's AI">
  <span class="trigger-prompt">▸ </span>sharriy.ai
</button>

<!-- CHAT WIDGET ─────────────────────────────────────────── -->
<div id="chat-widget" aria-hidden="true">
  <div id="chat-header">
    <span class="chat-dot"></span>
    <span id="chat-title">sharriy.ai</span>
    <button id="chat-close" aria-label="Close chat">✕</button>
  </div>
  <div id="chat-messages">
    <div class="msg msg-ai">Hey 👋 Ask me anything about sharriy's stack, projects, or blog.</div>
  </div>
  <form id="chat-form">
    <input id="chat-input" type="text" placeholder="ask something..." autocomplete="off" maxlength="200" />
    <button type="submit" id="chat-send">⏎</button>
  </form>
</div>

</Mainlayout>

<script defer src="/scripts/chat.js"></script>
