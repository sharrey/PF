---
import Mainlayout from "../../Layout/Mainlayout.astro";
import { vulns } from "../../data/vulns";
import type { Severity } from "../../data/vulns";

const sorted = [...vulns].sort((a, b) => {
  const order: Record<Severity, number> = { critical: 0, high: 1, medium: 2, low: 3 };
  return order[a.severity] - order[b.severity] || b.cvss - a.cvss;
});

const severityStyle: Record<Severity, string> = {
  critical: 'text-red-400 border-red-900 bg-red-950/30',
  high:     'text-orange-400 border-orange-900 bg-orange-950/20',
  medium:   'text-amber-400 border-amber-900 bg-amber-950/20',
  low:      'text-zinc-400 border-zinc-700 bg-zinc-900/30',
};

const cvssColor = (n: number) =>
  n >= 9   ? 'text-red-400' :
  n >= 7   ? 'text-orange-400' :
  n >= 4   ? 'text-amber-400' : 'text-zinc-400';

const counts = {
  critical: vulns.filter(v => v.severity === 'critical').length,
  high:     vulns.filter(v => v.severity === 'high').length,
  medium:   vulns.filter(v => v.severity === 'medium').length,
};
---

<Mainlayout
  title="security — sharriy.sh"
  seoTitle="Security Advisories — sharriy DevOps Engineer"
  seoDesc="Latest CVEs and vulnerability advisories for DevOps and cloud infrastructure — 2025."
>

<!-- HEADER ──────────────────────────────────────────────── -->
<section class="px-4 sm:px-6 pt-10 pb-6 max-w-5xl mx-auto">
  <div class="font-mono text-xs text-zinc-600 mb-8 flex items-center gap-2 flex-wrap" data-aos="fade-right">
    <span class="text-green-600">sharriy@devops</span><span>:</span><span class="text-blue-400">~</span><span>$</span>
    <span class="text-zinc-500">grep -r "CVE" ./advisories/ --severity=high</span>
  </div>

  <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-3" data-aos="fade-up" data-aos-delay="60">
    /security<span class="text-red-500 flicker">_</span>
  </h1>
  <p class="font-mono text-xs sm:text-sm text-zinc-600 mb-6" data-aos="fade-up" data-aos-delay="120">
    {vulns.length} advisories &nbsp;·&nbsp; Latest CVEs affecting DevOps & cloud infrastructure in 2025.
  </p>

  <!-- Severity summary bar -->
  <div class="flex flex-wrap gap-3 font-mono text-xs mb-2" data-aos="fade-up" data-aos-delay="180">
    <span class="glass-card border border-red-900 text-red-400 px-3 py-1.5 rounded-lg flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span>
      CRITICAL &nbsp;<span class="text-red-600">{counts.critical}</span>
    </span>
    <span class="glass-card border border-orange-900 text-orange-400 px-3 py-1.5 rounded-lg flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-orange-500 inline-block"></span>
      HIGH &nbsp;<span class="text-orange-600">{counts.high}</span>
    </span>
    <span class="glass-card border border-amber-900 text-amber-400 px-3 py-1.5 rounded-lg flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
      MEDIUM &nbsp;<span class="text-amber-600">{counts.medium}</span>
    </span>
  </div>
</section>

<!-- CVE LIST ─────────────────────────────────────────────── -->
<section class="px-4 sm:px-6 pb-16 max-w-5xl mx-auto">
  <div class="space-y-4">
    {sorted.map((v, i) => (
      <div class="glass-card rounded-xl overflow-hidden" data-aos="fade-up" data-aos-delay={i * 40}>

        <!-- Card header row -->
        <div class="flex flex-wrap items-center gap-3 px-5 pt-5 pb-3 border-b border-white/5">
          <span class={`font-mono text-xs uppercase tracking-widest border px-2 py-0.5 rounded-md ${severityStyle[v.severity]}`}>
            {v.severity}
          </span>
          <span class={`font-mono text-lg font-bold ${cvssColor(v.cvss)}`}>{v.cvss}</span>
          <span class="font-mono text-xs text-zinc-500">CVSS</span>
          <span class="font-mono text-xs text-green-500 font-bold ml-auto">{v.cve}</span>
          <span class="font-mono text-xs text-zinc-700">{v.date}</span>
        </div>

        <!-- Body -->
        <div class="px-5 py-4">
          <h2 class="font-bold text-sm sm:text-base text-white mb-1 leading-snug">{v.title}</h2>

          <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-zinc-600 mb-3">
            <span><span class="text-zinc-700">component:</span> <span class="text-zinc-400">{v.component}</span></span>
            <span><span class="text-zinc-700">affected:</span> <span class="text-amber-500/80">{v.affected}</span></span>
            <span><span class="text-zinc-700">fixed in:</span> <span class="text-green-500/80">{v.fixed}</span></span>
          </div>

          <p class="font-mono text-xs text-zinc-500 leading-relaxed mb-3">{v.summary}</p>

          <!-- Impact -->
          <div class="mb-3">
            <div class="font-mono text-xs text-red-500/70 mb-1">## impact</div>
            <p class="font-mono text-xs text-zinc-500 leading-relaxed">{v.impact}</p>
          </div>

          <!-- Fix -->
          <div class="bg-green-950/20 border border-green-900/40 rounded-lg px-4 py-3">
            <div class="font-mono text-xs text-green-500/70 mb-1">## fix</div>
            <p class="font-mono text-xs text-zinc-400 leading-relaxed">{v.fix}</p>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 mt-3">
            {v.tags.map(tag => (
              <span class="font-mono text-xs text-zinc-700 border border-zinc-800 px-2 py-0.5 rounded-md glass-card">
                #{tag}
              </span>
            ))}
          </div>
        </div>

      </div>
    ))}
  </div>

  <div class="font-mono text-xs text-zinc-800 mt-10 text-center">
    // {vulns.length} advisories tracked &nbsp;·&nbsp; updated regularly &nbsp;·&nbsp; always patch
  </div>
</section>

</Mainlayout>
