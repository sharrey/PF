---
import MainHead from "./MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const { title, seoTitle, seoDesc } = Astro.props;
---

<html lang="en">
  <head>
    <MainHead title={title} seoTitle={seoTitle} seoDesc={seoDesc} />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm/css/xterm.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.1/dist/aos.css" />

    <!-- CDN Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.1/dist/aos.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/typed.js@2.0.12" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm/lib/xterm.min.js" defer></script>

    <!-- Local Scripts -->
    <script src="/scripts/theme.js" defer></script>
    <script src="/scripts/hero-typed.js" defer></script>
    <script src="/scripts/terminal.js" defer></script>
    <script src="/scripts/animations.js" defer></script>
    <script src="/scripts/copy-code.js" defer></script>
    <script src="/scripts/confetti.js" type="module"></script>
  </head>

  <body class="bg-black text-white flex flex-col font-sans" style="min-height: 100vh;">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
