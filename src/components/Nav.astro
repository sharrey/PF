---
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-zinc-900" style="background: rgba(7,7,7,0.95); backdrop-filter: blur(8px);">
  <div class="max-w-5xl mx-auto px-6 h-12 flex items-center justify-between">

    <!-- Logo / brand -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="relative h-8 w-8 overflow-hidden">
        <img
          src="/rizz/fire.gif"
          alt=""
          class="absolute inset-0 h-full w-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        />
        <img
          src="/rizz/logo2.png"
          alt="sharriy"
          class="relative h-full w-full group-hover:opacity-0 transition-opacity duration-200"
        />
      </div>
      <span class="font-bold text-sm text-white">
        sharriy<span class="text-green-500">.sh</span>
      </span>
    </a>

    <!-- Nav links + toggles -->
    <nav class="flex items-center gap-1">
      <a href="/" class={`nav-link px-3 py-1 rounded-sm hover:bg-zinc-900 ${pathname === '/' ? 'text-green-400' : ''}`}>
        ~/home
      </a>
      <a href="/about" class={`nav-link px-3 py-1 rounded-sm hover:bg-zinc-900 ${pathname === '/about' ? 'text-green-400' : ''}`}>
        ~/about
      </a>
      <a href="/blog" class={`nav-link px-3 py-1 rounded-sm hover:bg-zinc-900 ${pathname.startsWith('/blog') ? 'text-green-400' : ''}`}>
        ~/blog
      </a>
      <a href="https://github.com/sharrey" target="_blank" rel="noopener"
        class="nav-link px-3 py-1 rounded-sm hover:bg-zinc-900 flex items-center gap-1">
        <img src="https://static.cdnlogo.com/logos/g/69/github-icon.svg" class="w-3.5 h-3.5 opacity-60" alt="" />
        ~/github
      </a>

      <!-- Divider -->
      <span class="text-zinc-800 mx-1 select-none">|</span>

      <!-- Sound toggle -->
      <button id="sound-toggle" class="nav-toggle" title="Toggle typing sound">[♪ on]</button>

      <!-- Theme toggle -->
    
    </nav>

  </div>
</header>
